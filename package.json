{
  "name": "ai-ladder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "update:artificial-analysis": "python3 api/artificial_analysis.py",
    "update:exchange-rates": "node scripts/update-exchange-rates.mjs",
    "update:coding-plans-timestamp": "node scripts/stamp-json-timestamp.mjs public/data/coding-plans.json",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "fetch:codex-radar": "node scripts/fetch-codex-radar.mjs",
    "validate:codex-radar": "node scripts/validate-codex-radar.mjs",
    "import:codex-radar": "node scripts/import-codex-radar.mjs"
  },
  "dependencies": {
    "playwright": "^1.60.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.2.0"
  }
}
